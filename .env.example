# ─────────────────────────────────────────────────────────────
#  VayuSangam – Root Environment Variables (Backend / Render)
#  Copy to .env and fill in values.
#  NEVER commit .env to git; .env.example is safe to commit.
# ─────────────────────────────────────────────────────────────

# CORS: comma-separated list of allowed frontend origins (no trailing slash).
# Set this in the Render dashboard after your Vercel deployment URL is known.
# Example: https://VayuSangam.vercel.app,https://www.VayuSangam.in
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: absolute path to the /data directory if not at repo root.
# Render always clones the repo with data/ at repo root, so this is rarely needed.
# DATA_DIR=/opt/render/project/src/data
