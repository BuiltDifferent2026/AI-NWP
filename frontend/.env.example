# Mapbox GL public access token
# Get yours at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuLWhlcmUifQ.example

# Backend API base URL (no trailing slash)
# - LOCAL DEV: leave blank — Vite proxies /api to http://127.0.0.1:8000
# - PRODUCTION (Vercel): set to your Render service URL
# VITE_API_BASE_URL=https://your-VayuSangam-api.onrender.com
